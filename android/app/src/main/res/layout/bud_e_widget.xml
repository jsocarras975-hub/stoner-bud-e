<?xml version="1.0" encoding="utf-8"?>
<!-- Bigger widget (4 wide, 2 tall): title + stash line, Talk / Open,
     then Log / Stash / Tonight. The stash line is filled in by the app
     whenever the stash changes; until then it shows "Stash: —". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bud_e_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bud-E"
            android:textColor="#c6f25c"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_stash"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1"
            android:text="Stash: —"
            android:textColor="#f2f0eb"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_talk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bud_e_widget_btn_talk"
            android:text="💬 Talk"
            android:textColor="#07110c"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_open"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bud_e_widget_btn_ghost"
            android:text="Open Bud-E"
            android:textColor="#f2f0eb" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_log"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bud_e_widget_btn_ghost"
            android:text="Log"
            android:textColor="#f2f0eb"
            android:textSize="13sp" />

        <Button
            android:id="@+id/widget_stash_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bud_e_widget_btn_ghost"
            android:text="Stash"
            android:textColor="#f2f0eb"
            android:textSize="13sp" />

        <Button
            android:id="@+id/widget_tonight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bud_e_widget_btn_ghost"
            android:text="Tonight"
            android:textColor="#f2f0eb"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
