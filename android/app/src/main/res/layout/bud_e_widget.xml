<?xml version="1.0" encoding="utf-8"?>
<!-- Sleeker widget (4 wide, 2 tall): a leaf-disc header with the stash
     line, one big lime Talk pill, then three slim glass pills (Log /
     Stash / Tonight), then a big clock + weather + date block that fills
     the rest of the card. The card background is the app-icon cosmic
     nebula art (bud_e_widget_bg_img), darkened so the text stays
     readable. Tapping the header opens the app; Talk opens the
     bubble chat panel. The stash line is filled in by the app whenever
     the stash changes; until then it shows "Stash: —". The time is a
     TextClock (it keeps itself current); the temperature is published by
     the app whenever it fetches the weather, and shows "—°F" until the
     first fetch; the date line is a TextClock too ("Tuesday, Nov 10").
     The clock/weather/date block stretches to fill whatever
     space is left, so the card never has a dead empty patch at the
     bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bud_e_widget_bg_img"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_leaf"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Bud-E"
            android:scaleType="fitCenter"
            android:src="@drawable/bud_e_bubble_icon" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Bud-E"
            android:textColor="#f2f0eb"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_stash"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1"
            android:text="Stash: —"
            android:textColor="#a9bfae"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/widget_talk"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bud_e_widget_btn_talk"
        android:minHeight="0dp"
        android:text="💬 Talk to Bud-E"
        android:textColor="#07110c"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_log"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/bud_e_widget_btn_ghost"
            android:minHeight="0dp"
            android:text="Log"
            android:textColor="#e8f0e8"
            android:textSize="13sp" />

        <Button
            android:id="@+id/widget_stash_btn"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bud_e_widget_btn_ghost"
            android:minHeight="0dp"
            android:text="Stash"
            android:textColor="#e8f0e8"
            android:textSize="13sp" />

        <Button
            android:id="@+id/widget_tonight"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bud_e_widget_btn_ghost"
            android:minHeight="0dp"
            android:text="Tonight"
            android:textColor="#e8f0e8"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/widget_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm a"
                android:format24Hour="H:mm"
                android:textColor="#c6f25c"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="🍃"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/widget_weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:maxLines="1"
                android:text="—°F"
                android:textColor="#f2f0eb"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextClock
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:format12Hour="EEEE, MMM d"
            android:format24Hour="EEEE, MMM d"
            android:textColor="#e8f0e8"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/widget_strain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="⭐ Today's pick: —"
            android:textColor="#c6f25c"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
