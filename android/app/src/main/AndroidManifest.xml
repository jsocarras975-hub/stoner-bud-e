<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Package visibility (Android 11+): without these, resolveActivity()
         returns null for the clock/calendar apps and Bud-E reports that no
         app can do it — even though the apps are on the phone. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
            <data android:scheme="content" android:host="com.android.calendar" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share into Bud-E from any app (text or a link lands in the
                 chat box). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Talk fallback: when Bud-E is not the default assistant, the
                 phone shows a list of apps for the Talk action — this filter
                 puts Bud-E in that list. Tapping it opens the app to the
                 chat tab. When Bud-E IS the default, the phone goes straight
                 to the voice session instead. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Long-press the app icon: Talk / Tonight / Log a session. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Default-assistant layer: makes Android offer Bud-E in
             Settings → Apps → Default apps → Digital assistant app, so
             long-press home opens Bud-E's voice session. All three services
             are required: the interaction service (always running when
             selected), the session service (creates the overlay session),
             and the recognition service (speech input). -->
        <service
            android:name=".BudEInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
        </service>

        <service
            android:name=".BudESessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionSessionService" />
            </intent-filter>
        </service>

        <service
            android:name=".BudERecognitionService"
            android:exported="true"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>

        <!-- Reminder alarms: fires the notification even with the app closed. -->
        <receiver
            android:name=".BudEReminderReceiver"
            android:exported="false" />

        <!-- Home-screen widget: Talk / Open Bud-E / Log / Stash / Tonight. -->
        <receiver
            android:name=".BudEWidgetProvider"
            android:exported="true"
            android:label="Bud-E">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bud_e_widget_info" />
        </receiver>

        <!-- Music widget: a slim now-playing bar (previous / play-pause / next). -->
        <receiver
            android:name=".BudEMusicWidgetProvider"
            android:exported="true"
            android:label="Bud-E Music">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bud_e_music_widget_info" />
        </receiver>

        <!-- Floating chat bubble: a foreground service hosts the overlay,
             so the bubble stays up when the app is closed. specialUse is
             the fitting type for an overlay bubble on Android 14+. -->
        <service
            android:name=".BudEBubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Bud-E Keyboard: an input method (IME) in this same app. The user
             enables it in Settings → Languages & input (Android makes the
             user pick the keyboard — an app can never set itself). -->
        <service
            android:name=".BudEKeyboardService"
            android:label="Bud-E Keyboard"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/bude_keyboard_method" />
        </service>

        <!-- After a reboot, bring the bubble back if it was left on. -->
        <receiver
            android:name=".BudEBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice chat mic: getUserMedia needs this declared or Android never
         asks for the microphone and recording fails silently. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Flashlight: CameraManager torch needs the camera permission. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Reminders: exact alarms while idle (also declared by the
         local-notifications plugin; stated here because BudEActions
         depends on it directly). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Alarms: the clock app's SET_ALARM screen refuses callers that do
         not hold this (normal permission, granted automatically at
         install). Without it every alarm start fails with a
         SecurityException — from the app and from the voice session. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Calls / texts: looking a name up in contacts needs this (dangerous
         permission, asked once at runtime when first needed). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Floating chat bubble: drawing over other apps, plus the
         foreground service that keeps the bubble up when the app is
         closed (specialUse is the fitting type for an overlay bubble). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
</manifest>
